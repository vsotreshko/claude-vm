#!/usr/bin/env bash
# claude-docker — Run Claude Code in an isolated Docker container
# Install: make install
# Usage:   claude-docker [command]

set -euo pipefail

IMAGE_NAME="claude-code-sandbox"
DOCKERFILE_NAME="Dockerfile.claude"
DOCKERFILE_LOCAL="$HOME/.claude-vm/$DOCKERFILE_NAME"

GREEN='\033[0;32m'; BLUE='\033[0;34m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
log()     { echo -e "${BLUE}==> ${NC}$1"; }
success() { echo -e "${GREEN} ✓ ${NC}$1"; }
warn()    { echo -e "${YELLOW} ⚠ ${NC}$1"; }
die()     { echo -e "${RED} ✗ ${NC}$1"; exit 1; }

WORK_DIR="$(pwd)"
PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/-*$//')"

# Detect monorepo root by walking up to find lock file
find_project_root() {
  local dir="$WORK_DIR"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/pnpm-lock.yaml" ] || [ -f "$dir/package-lock.json" ] || [ -f "$dir/yarn.lock" ] || [ -f "$dir/pnpm-workspace.yaml" ]; then
      echo "$dir"
      return
    fi
    dir="$(dirname "$dir")"
  done
  echo "$WORK_DIR"
}

PROJECT_DIR="$(find_project_root)"
PROJECT_NAME="$(basename "$PROJECT_DIR" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/-*$//')"
CONTAINER_NAME="claude-docker-${PROJECT_NAME}"
VOLUME_NAME="claude-docker-nm-${PROJECT_NAME}"
GCLOUD_VOL_NAME="claude-docker-gcloud-${PROJECT_NAME}"
GH_VOL_NAME="claude-docker-gh-${PROJECT_NAME}"

USE_TMUX=false
USE_GCLOUD=false
USE_GH=false

check_prereqs() {
  if ! command -v docker &>/dev/null; then
    die "Docker not found. Install Docker Desktop: https://docs.docker.com/get-docker/"
  fi
  if ! docker info &>/dev/null 2>&1; then
    die "Docker daemon is not running. Start Docker Desktop and try again."
  fi
}

find_dockerfile() {
  if [ -f "$DOCKERFILE_LOCAL" ]; then
    echo "$DOCKERFILE_LOCAL"
  elif [ -f "$(dirname "$(readlink -f "$0")")/$DOCKERFILE_NAME" ]; then
    echo "$(dirname "$(readlink -f "$0")")/$DOCKERFILE_NAME"
  else
    die "Dockerfile not found. Expected at $DOCKERFILE_LOCAL or next to this script."
  fi
}

ensure_image() {
  if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
    local dockerfile
    dockerfile="$(find_dockerfile)"
    log "Building Docker image '$IMAGE_NAME' (first run, may take a few minutes)..."
    docker build -t "$IMAGE_NAME" --build-arg HOST_UID="$(id -u)" -f "$dockerfile" "$(dirname "$dockerfile")"
    success "Image '$IMAGE_NAME' built"
  fi
}

detect_pkg_manager() {
  local dir="$PROJECT_DIR"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/pnpm-lock.yaml" ]; then
      echo "pnpm install"
      return
    elif [ -f "$dir/yarn.lock" ]; then
      echo "yarn install"
      return
    elif [ -f "$dir/package-lock.json" ]; then
      echo "npm install"
      return
    fi
    dir="$(dirname "$dir")"
  done
  echo "npm install"
}

cmd_run() {
  check_prereqs
  ensure_image

  # If container is already running, attach to it
  if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    log "Attaching to running container '$CONTAINER_NAME'..."
    docker exec -it "$CONTAINER_NAME" bash -c "
      if [ ! -f /home/claude/.claude.json ]; then
        latest=\$(ls -t /home/claude/.claude/backups/.claude.json.backup.* 2>/dev/null | head -1)
        [ -n \"\$latest\" ] && cp \"\$latest\" /home/claude/.claude.json && echo '==> Restored .claude.json from backup'
      fi
      cd '${WORK_DIR}' && claude --dangerously-skip-permissions"
    return
  fi

  # Remove stopped container with same name
  docker rm -f "$CONTAINER_NAME" &>/dev/null || true

  log "Starting container '$CONTAINER_NAME'..."
  echo -e "  ${BLUE}Local:${NC}     $WORK_DIR"
  echo -e "  ${BLUE}Root:${NC}      $PROJECT_DIR"
  echo -e "  ${BLUE}Container:${NC} $CONTAINER_NAME"
  echo ""

  # Build volume mounts
  local vol_flags=()
  vol_flags+=(-v "$PROJECT_DIR:$PROJECT_DIR")
  vol_flags+=(-v "$HOME/.claude:/home/claude/.claude")
  vol_flags+=(-v "$HOME/.claude:$HOME/.claude")
  [ -f "$HOME/.claude.json" ] && vol_flags+=(-v "$HOME/.claude.json:/tmp/.claude.json.init:ro")

  # node_modules volume overlay (only if package.json exists)
  if [ -f "$PROJECT_DIR/package.json" ]; then
    vol_flags+=(-v "${VOLUME_NAME}:${PROJECT_DIR}/node_modules")
  fi

  # Optional config mounts
  [ -f "$HOME/.gitconfig" ] && vol_flags+=(-v "$HOME/.gitconfig:/home/claude/.gitconfig:ro")
  [ -d "$HOME/.ssh" ] && vol_flags+=(-v "$HOME/.ssh:/home/claude/.ssh:ro")
  if [ "$USE_GCLOUD" = true ] || docker volume inspect "$GCLOUD_VOL_NAME" &>/dev/null; then
    vol_flags+=(-v "${GCLOUD_VOL_NAME}:/home/claude/.config/gcloud")
  fi
  if [ "$USE_GH" = true ] || docker volume inspect "$GH_VOL_NAME" &>/dev/null; then
    vol_flags+=(-v "${GH_VOL_NAME}:/home/claude/.config/gh")
  fi

  # Build startup command
  local pkg_cmd
  pkg_cmd="$(detect_pkg_manager)"

  # Share host pnpm store with container to avoid re-downloading packages
  local pnpm_store=""
  if [[ "$pkg_cmd" == "pnpm install" ]] && command -v pnpm &>/dev/null; then
    pnpm_store="$(pnpm store path 2>/dev/null | sed 's|/v[0-9].*||')"
  fi
  if [ -n "$pnpm_store" ]; then
    vol_flags+=(-v "$pnpm_store:/home/claude/.pnpm-store")
  fi

  local startup_cmd=""
  # Sync credentials: prefer host's .claude.json; fall back to shared copy from last container session
  startup_cmd="${startup_cmd}if [ -f /tmp/.claude.json.init ]; then cp /tmp/.claude.json.init /home/claude/.claude.json; "
  startup_cmd="${startup_cmd}elif [ -f /home/claude/.claude/.claude.json.shared ]; then cp /home/claude/.claude/.claude.json.shared /home/claude/.claude.json; "
  startup_cmd="${startup_cmd}else latest=\$(ls -t /home/claude/.claude/backups/.claude.json.backup.* 2>/dev/null | head -1); [ -n \"\$latest\" ] && cp \"\$latest\" /home/claude/.claude.json && echo '==> Restored .claude.json from backup'; fi; "
  # Fix ownership of node_modules volume (Docker creates it as root)
  if [ -f "$PROJECT_DIR/package.json" ]; then
    startup_cmd="${startup_cmd}sudo chown claude:claude '${PROJECT_DIR}/node_modules'; "
  fi
  # Install pnpm if needed
  if [[ "$pkg_cmd" == "pnpm install" ]]; then
    startup_cmd="${startup_cmd}command -v pnpm >/dev/null || sudo npm install -g pnpm; pnpm config set --global store-dir /home/claude/.pnpm-store; "
  fi
  # Install deps if node_modules volume is empty and package.json exists
  if [ -f "$PROJECT_DIR/package.json" ]; then
    startup_cmd="${startup_cmd}if [ ! -d '${PROJECT_DIR}/node_modules/node_modules' ] && [ -z \"\$(ls -A '${PROJECT_DIR}/node_modules' 2>/dev/null)\" ]; then echo '==> Installing dependencies...' && cd '${PROJECT_DIR}' && ${pkg_cmd}; fi; "
  fi
  if [ "$USE_GCLOUD" = true ]; then
    startup_cmd="${startup_cmd}sudo chown -R claude:claude /home/claude/.config/gcloud; echo '==> Running gcloud auth login...' && gcloud auth login --no-launch-browser && gcloud auth application-default login --no-launch-browser; "
  fi
  if [ "$USE_GH" = true ]; then
    startup_cmd="${startup_cmd}sudo chown -R claude:claude /home/claude/.config/gh; "
    startup_cmd="${startup_cmd}echo '' && echo '==> GitHub auth - create a fine-grained PAT:' && echo '    https://github.com/settings/personal-access-tokens/new?description=claude-docker-${PROJECT_NAME}' && echo '    Select repos to allow, set permissions, then paste the token:' && printf 'Token: ' && read -rs _GH_TOKEN && echo; "
    startup_cmd="${startup_cmd}if [ -z \"\$_GH_TOKEN\" ]; then echo ' ✗ No token provided, skipping gh auth'; unset _GH_TOKEN; else printf '%s' \"\$_GH_TOKEN\" | gh auth login --with-token && unset _GH_TOKEN && (gh auth setup-git 2>/dev/null || echo ' ⚠ git credential helper not configured (gitconfig is read-only, run gh auth setup-git manually if needed)') || { unset _GH_TOKEN; echo ' ✗ gh auth failed - re-run with --gh to retry'; exit 1; }; fi; "
  fi
  startup_cmd="${startup_cmd}echo '==> Starting Claude...' && cd '${WORK_DIR}' && claude --dangerously-skip-permissions; cp /home/claude/.claude.json /home/claude/.claude/.claude.json.shared 2>/dev/null || true"

  # Detect host networking support (works on Linux and OrbStack, not Docker Desktop Mac/Win)
  local net_flags=()
  if [ "$(uname -s)" = "Linux" ] || docker info 2>/dev/null | grep -q 'Operating System: OrbStack'; then
    net_flags+=(--network host)
  else
    # Fallback: use --add-host so host.docker.internal resolves to the host
    net_flags+=(--add-host host.docker.internal:host-gateway)
    # Also map custom hosts from /etc/hosts
    while IFS= read -r line; do
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      [[ -z "$line" ]] && continue
      if echo "$line" | grep -qE '^127\.0\.0\.1[[:space:]]'; then
        for h in $(echo "$line" | awk '{$1=""; print}' | xargs); do
          [[ "$h" == "localhost" || "$h" == "broadcasthost" ]] && continue
          net_flags+=(--add-host "${h}:host-gateway")
        done
      fi
    done < /etc/hosts 2>/dev/null
    warn "Host networking unavailable. Services on host must be accessed via host.docker.internal instead of localhost."
  fi

  # shellcheck disable=SC2086
  docker run -it \
    --name "$CONTAINER_NAME" \
    --hostname "claude-sandbox" \
    "${net_flags[@]}" \
    "${vol_flags[@]}" \
    -e ANTHROPIC_API_KEY \
    "$IMAGE_NAME" \
    -c "$startup_cmd"

  # Sync credentials refreshed inside container back to host
  if [ -f "$HOME/.claude/.claude.json.shared" ]; then
    cp "$HOME/.claude/.claude.json.shared" "$HOME/.claude.json" 2>/dev/null || true
  fi
}

cmd_stop() {
  check_prereqs
  if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    log "Stopping container '$CONTAINER_NAME'..."
    docker stop "$CONTAINER_NAME" --time 30
    success "Container stopped"
  else
    warn "Container '$CONTAINER_NAME' is not running"
  fi
}

cmd_status() {
  check_prereqs
  if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    docker inspect "$CONTAINER_NAME" --format '
  Name:    {{.Name}}
  Status:  {{.State.Status}}
  Started: {{.State.StartedAt}}
  Image:   {{.Config.Image}}'
    echo ""
    echo "  Mounts:"
    docker inspect "$CONTAINER_NAME" --format '{{range .Mounts}}    {{.Type}}: {{.Source}} → {{.Destination}}
{{end}}'
  else
    warn "No container found for project '$PROJECT_NAME'"
  fi
}

cmd_update() {
  check_prereqs
  local dockerfile
  dockerfile="$(find_dockerfile)"
  log "Rebuilding image '$IMAGE_NAME' (no cache)..."
  docker build --no-cache -t "$IMAGE_NAME" --build-arg HOST_UID="$(id -u)" -f "$dockerfile" "$(dirname "$dockerfile")"
  success "Image '$IMAGE_NAME' updated"
}

cmd_clean() {
  check_prereqs
  log "Removing container '$CONTAINER_NAME'..."
  docker rm -f "$CONTAINER_NAME" 2>/dev/null && success "Container removed" || warn "Container not found"
  log "Removing volume '$VOLUME_NAME'..."
  docker volume rm "$VOLUME_NAME" 2>/dev/null && success "Volume removed" || warn "Volume not found"
  log "Removing gcloud volume '$GCLOUD_VOL_NAME'..."
  docker volume rm "$GCLOUD_VOL_NAME" 2>/dev/null && success "gcloud volume removed" || warn "gcloud volume not found"
  log "Removing gh volume '$GH_VOL_NAME'..."
  docker volume rm "$GH_VOL_NAME" 2>/dev/null && success "gh volume removed" || warn "gh volume not found"
}

cmd_purge() {
  check_prereqs
  local containers volumes
  containers="$(docker ps -a --filter "name=claude-docker-" --format "{{.Names}}" | sort)"
  volumes="$(docker volume ls --filter "name=claude-docker-" --format "{{.Name}}" | sort)"

  if [ -z "$containers" ] && [ -z "$volumes" ]; then
    warn "Nothing to purge — no claude-docker containers or volumes found."
    return
  fi

  echo ""
  echo -e "${RED}This will permanently delete ALL claude-docker sessions:${NC}"
  echo ""
  if [ -n "$containers" ]; then
    echo -e "  ${BLUE}Containers:${NC}"
    echo "$containers" | sed 's/^/    /'
  fi
  if [ -n "$volumes" ]; then
    echo -e "  ${BLUE}Volumes:${NC}"
    echo "$volumes" | sed 's/^/    /'
  fi
  echo ""
  printf "  Type 'yes' to confirm: "
  read -r answer
  [ "$answer" != "yes" ] && { warn "Aborted."; return; }
  echo ""

  if [ -n "$containers" ]; then
    log "Stopping and removing all containers..."
    echo "$containers" | xargs docker rm -f 2>/dev/null && success "Containers removed" || warn "Some containers could not be removed"
  fi
  if [ -n "$volumes" ]; then
    log "Removing all volumes..."
    echo "$volumes" | xargs docker volume rm 2>/dev/null && success "Volumes removed" || warn "Some volumes could not be removed"
  fi
  success "Purge complete."
}

cmd_shell() {
  check_prereqs
  if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    die "Container '$CONTAINER_NAME' is not running. Start it with: claude-docker"
  fi
  docker exec -it "$CONTAINER_NAME" bash -c "cd '${WORK_DIR}' && exec bash"
}

cmd_list() {
  check_prereqs
  echo -e "${BLUE}Running claude-docker containers:${NC}"
  docker ps --filter "name=claude-docker-" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
}

usage() {
  echo ""
  echo -e "  ${BLUE}claude-docker${NC} — Run Claude Code in an isolated Docker container"
  echo ""
  echo -e "  ${GREEN}From any project directory:${NC}"
  echo "    claude-docker              Launch Claude Code in this repo"
  echo "    claude-docker shell        Open a bash shell in the container"
  echo "    claude-docker status       Container info and mounts"
  echo "    claude-docker list         List all running claude-docker containers"
  echo ""
  echo -e "  ${GREEN}Management:${NC}"
  echo "    claude-docker stop         Stop the container"
  echo "    claude-docker clean        Remove container and volumes (node_modules + gcloud + gh)"
  echo "    claude-docker purge        Delete ALL claude-docker containers and volumes (interactive)"
  echo "    claude-docker update       Rebuild the Docker image (no cache)"
  echo ""
  echo -e "  ${GREEN}Flags:${NC}"
  echo "    --gcloud            Mount per-project gcloud auth (login on first run, persists until clean)"
  echo "    --gh                Fine-grained GitHub PAT auth (scoped to selected repos, persists until clean)"
  echo ""
}

# Parse flags
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --tmux) USE_TMUX=true; shift ;;
    --gcloud) USE_GCLOUD=true; shift ;;
    --gh) USE_GH=true; shift ;;
    *) die "Unknown flag '$1'. Run: claude-docker help" ;;
  esac
done

case "${1:-run}" in
  run|"")    cmd_run ;;
  stop)      cmd_stop ;;
  status)    cmd_status ;;
  update)    cmd_update ;;
  clean)     cmd_clean ;;
  purge)     cmd_purge ;;
  shell)     cmd_shell ;;
  list)      cmd_list ;;
  help|--help|-h) usage ;;
  *) die "Unknown command '$1'. Run: claude-docker help" ;;
esac
